{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canary-ci.dev/schemas/v1/mock-profile.schema.json",
  "title": "MockProfileSpec",
  "description": "User-defined custom tool mock profile for CanaryCI (Phase 2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "profile_id", "tools"],
  "properties": {
    "api_version": {
      "type": "string",
      "const": "canary-ci/mock-v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "description": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "input_schema", "default_response"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "description": { "type": "string" },
          "input_schema": { "type": "object" },
          "is_sink": { "type": "boolean", "default": false },
          "trust_zone": {
            "type": "string",
            "enum": ["internal_trusted", "internal_restricted", "external_untrusted"],
            "default": "internal_trusted"
          },
          "conditional_responses": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["when_args", "response"],
              "properties": {
                "when_args": { "type": "object" },
                "response": { "type": "string" },
                "contains_untrusted_content": { "type": "boolean", "default": false },
                "untrusted_source_id": { "type": "string" }
              }
            }
          },
          "default_response": { "type": "string" },
          "default_untrusted": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
